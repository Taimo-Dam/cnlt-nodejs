<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lỗi — The Blog</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <header>
    <div class="header-top">
      <a href="/" class="logo">The Blog</a>
      <nav>
        <a href="/">Trang chủ</a>
        <a href="/blogposts/new" class="btn-new">+ Tạo bài viết</a>
      </nav>
    </div>
  </header>

  <main class="wrapper">
    <div class="main-content">
      <div class="content">
        <div class="container">
          <div style="text-align: center; padding: 80px 20px;">
            <div style="font-size: 64px; margin-bottom: 20px;">😕</div>
            <h1 class="article-title" style="border: none;">Oops! Đã xảy ra lỗi</h1>
            <p style="font-size: 16px; color: #666; margin-bottom: 30px;">
              <%= error || 'Xin lỗi, điều gì đó không hoạt động như kỳ vọng.' %>
            </p>
            <a href="/" class="button button-primary">← Về trang chủ</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <span>The Blog &copy; <%= new Date().getFullYear() %></span>
    <span>Node.js + MongoDB + EJS</span>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
