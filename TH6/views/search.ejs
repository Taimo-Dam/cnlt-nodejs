<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tìm kiếm — The Blog</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <header>
    <div class="header-top">
      <a href="/" class="logo">The Blog</a>
      
      <form class="search-box" id="search-form" method="GET" action="/search">
        <input type="text" name="q" placeholder="Tìm kiếm bài viết..." value="<%= searchQuery ? searchQuery : '' %>" autofocus>
      </form>

      <nav>
        <a href="/">Trang chủ</a>
        <button id="theme-toggle" class="theme-toggle">🌙</button>
        <a href="/blogposts/new" class="btn-new">+ Tạo bài viết</a>
      </nav>
    </div>
  </header>

  <main class="wrapper">
    <div class="main-content">
      <div class="content">
        <div class="container">
          <div class="alert alert-info">
            Kết quả tìm kiếm cho: <strong><%= searchQuery %></strong> — Tìm thấy <%= totalPosts %> bài viết
          </div>

          <% if (posts.length === 0) { %>
            <div class="empty">
              <p>😕 Không tìm thấy bài viết nào</p>
              <p style="font-size: 12px; color: #999;">Hãy thử từ khóa khác hoặc <a href="/" style="color: #111; text-decoration: underline;">quay lại trang chủ</a></p>
            </div>
          <% } else { %>
            <div class="post-grid" style="grid-template-columns: 1fr;">
              <% posts.forEach(post => { %>
                <div class="post-card">
                  <% if (post.category) { %>
                    <a href="/category/<%= post.category._id %>" class="post-list-category"><%= post.category.name %></a>
                  <% } %>
                  <div class="post-card-title"><%= post.title %></div>
                  <div class="post-card-body"><%= post.body.substring(0, 150) %>...</div>
                  <div style="font-size: 12px; color: #999; margin-bottom: 10px;">
                    📅 <%= post.createdAt.toLocaleDateString('vi-VN') %> • 👁️ <%= post.views %> lượt xem
                  </div>
                  <div class="post-card-footer">
                    <a href="/blogposts/<%= post._id %>" class="post-card-link">Xem chi tiết →</a>
                    <button class="action-like" data-post-id="<%= post._id %>">🤍</button>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
              <div class="pagination">
                <% if (currentPage > 1) { %>
                  <a href="/search?q=<%= encodeURIComponent(searchQuery) %>&page=<%= currentPage - 1 %>" class="pagination-item">← Trước</a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                  <% if (i === currentPage) { %>
                    <span class="pagination-item active"><%= i %></span>
                  <% } else { %>
                    <a href="/search?q=<%= encodeURIComponent(searchQuery) %>&page=<%= i %>" class="pagination-item"><%= i %></a>
                  <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                  <a href="/search?q=<%= encodeURIComponent(searchQuery) %>&page=<%= currentPage + 1 %>" class="pagination-item">Sau →</a>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

      <aside class="sidebar">
        <div class="sidebar-section">
          <h3 class="sidebar-title">🔍 Tìm kiếm</h3>
          <div class="sidebar-item">
            <p style="font-size: 12px; color: #666;">Từ khóa: <strong><%= searchQuery %></strong></p>
          </div>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">📂 Danh mục</h3>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <div class="sidebar-item">
                <a href="/category/<%= cat._id %>"><%= cat.name %></a>
                <span class="sidebar-badge"><%= cat.postCount %></span>
              </div>
            <% }) %>
          <% } %>
        </div>
      </aside>
    </div>
  </main>

  <footer>
    <span>The Blog &copy; <%= new Date().getFullYear() %></span>
    <span>Node.js + MongoDB + EJS</span>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
