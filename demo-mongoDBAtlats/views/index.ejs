<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Blog</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <header>
    <div class="header-top">
      <a href="/" class="logo">The Blog</a>
      
      <form class="search-box" id="search-form" method="GET" action="/search">
        <input type="text" name="q" placeholder="Tìm kiếm bài viết..." value="<%= searchQuery ? searchQuery : '' %>">
      </form>

      <nav>
        <a href="/">Trang chủ</a>
        <button id="theme-toggle" class="theme-toggle" style="background: none; border: none; cursor: pointer; font-size: 18px;">🌙</button>
        <a href="/blogposts/new" class="btn-new">+ Tạo bài viết</a>
      </nav>
    </div>
    <div class="header-date">
      <%= new Date().toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
    </div>
  </header>

  <main class="wrapper">
    <div class="main-content">
      <div class="content">
        <div class="container">
          <!-- Filters -->
          <div style="display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 200px;">
              <form method="GET" action="/">
                <label for="category-filter" style="display: inline-block; margin-right: 10px;">Danh mục:</label>
                <select id="category-filter" name="category" style="padding: 8px 12px; border: 1px solid #e0deda; border-radius: 4px;">
                  <option value="">Tất cả danh mục</option>
                  <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat._id %>" <%= selectedCategory === cat._id.toString() ? 'selected' : '' %>>
                        <%= cat.name %> (<%= cat.postCount %>)
                      </option>
                    <% }) %>
                  <% } %>
                </select>
              </form>
            </div>

            <div style="flex: 1; min-width: 200px;">
              <form method="GET" action="/">
                <label for="sort-filter" style="display: inline-block; margin-right: 10px;">Sắp xếp:</label>
                <select id="sort-filter" name="sort" style="padding: 8px 12px; border: 1px solid #e0deda; border-radius: 4px;">
                  <option value="-createdAt">Mới nhất</option>
                  <option value="createdAt">Cũ nhất</option>
                  <option value="title">Tên (A-Z)</option>
                  <option value="-views">Xem nhiều nhất</option>
                </select>
              </form>
            </div>
          </div>

          <!-- Search results info -->
          <% if (searchQuery) { %>
            <div class="alert alert-info" style="margin-bottom: 20px;">
              Kết quả tìm kiếm cho: <strong><%= searchQuery %></strong> (<%= totalPosts %> bài viết)
            </div>
          <% } %>

          <!-- Posts -->
          <% if (posts.length === 0) { %>
            <div class="empty">
              <p>😶 Chưa có bài viết nào.</p>
              <a href="/blogposts/new">Tạo bài viết đầu tiên →</a>
            </div>
          <% } else { %>
            <!-- Featured post -->
            <div class="section-header">
              <span class="section-label">Bài viết nổi bật</span>
              <span class="section-count"><%= totalPosts %> bài viết</span>
            </div>

            <div class="featured">
              <div class="featured-img">✦</div>
              <div class="featured-content">
                <div>
                  <span class="tag">Mới nhất</span>
                  <div class="featured-title"><%= posts[0].title %></div>
                  <div class="featured-body"><%= posts[0].body.substring(0, 220) %><%= posts[0].body.length > 220 ? '...' : '' %></div>
                </div>
                <div>
                  <% if (posts[0].createdAt) { %>
                    <div class="card-meta">
                      📅 <%= posts[0].createdAt.toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                      • 👁️ <%= posts[0].views %> lượt xem
                    </div>
                  <% } %>
                  <div class="featured-footer">
                    <a href="/blogposts/<%= posts[0]._id %>" class="read-more">Đọc tiếp →</a>
                    <div class="card-actions">
                      <button class="action-like" data-post-id="<%= posts[0]._id %>" title="Like bài viết">🤍</button>
                      <span class="like-count"><%= posts[0].likes.length %></span>
                      <a href="/blogposts/<%= posts[0]._id %>/edit" class="action-edit">Sửa</a>
                      <form action="/blogposts/<%= posts[0]._id %>/delete" method="POST" style="display: inline;">
                        <button type="submit" class="action-delete" onclick="return confirm('Xóa bài viết này?')">Xóa</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Grid posts -->
            <% if (posts.length > 1) { %>
              <div class="post-grid">
                <% posts.slice(1, 4).forEach(post => { %>
                  <div class="post-card">
                    <span class="tag">Bài viết</span>
                    <% if (post.category) { %>
                      <a href="/category/<%= post.category._id %>" class="post-list-category" style="margin-bottom: 10px;"><%= post.category.name %></a>
                    <% } %>
                    <div class="post-card-title"><%= post.title %></div>
                    <div class="post-card-body"><%= post.body.substring(0, 100) %><%= post.body.length > 100 ? '...' : '' %></div>
                    <div class="post-card-footer">
                      <a href="/blogposts/<%= post._id %>" class="post-card-link">Xem chi tiết →</a>
                      <div class="card-actions">
                        <button class="action-like" data-post-id="<%= post._id %>" title="Like bài viết">🤍</button>
                        <span class="like-count" style="font-size: 12px;"><%= post.likes.length %></span>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <!-- List posts -->
            <% if (posts.length > 4) { %>
              <div class="section-header" style="margin-top: 40px;">
                <span class="section-label">Tất cả bài viết</span>
                <span class="section-count"><%= posts.length > 4 ? posts.length - 4 : 0 %> bài khác</span>
              </div>
              <% posts.slice(4).forEach((post, i) => { %>
                <div class="post-list-item">
                  <span class="post-num">0<%= (currentPage - 1) * 6 + i + 5 %></span>
                  <div>
                    <a href="/blogposts/<%= post._id %>" style="text-decoration:none;color:inherit;display:block;">
                      <span class="post-list-title"><%= post.title %></span>
                    </a>
                    <% if (post.category) { %>
                      <a href="/category/<%= post.category._id %>" class="post-list-category"><%= post.category.name %></a>
                    <% } %>
                  </div>
                  <% if (post.createdAt) { %>
                    <span class="post-list-date"><%= post.createdAt.toLocaleDateString('vi-VN') %></span>
                  <% } %>
                  <div class="card-actions">
                    <button class="action-like" data-post-id="<%= post._id %>" title="Like"><%= post.likes.length > 0 ? '❤️' : '🤍' %></button>
                  </div>
                </div>
              <% }) %>
            <% } %>
          <% } %>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="pagination">
              <% if (currentPage > 1) { %>
                <a href="/?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" class="pagination-item">← Trước</a>
              <% } %>

              <% for (let i = 1; i <= totalPages; i++) { %>
                <% if (i === currentPage) { %>
                  <span class="pagination-item active"><%= i %></span>
                <% } else { %>
                  <a href="/?page=<%= i %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" class="pagination-item"><%= i %></a>
                <% } %>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="/?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" class="pagination-item">Sau →</a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-section">
          <h3 class="sidebar-title">📂 Danh mục</h3>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <div class="sidebar-item">
                <a href="/category/<%= cat._id %>"><%= cat.name %></a>
                <span class="sidebar-badge"><%= cat.postCount %></span>
              </div>
            <% }) %>
          <% } else { %>
            <p style="font-size: 12px; color: #888;">Chưa có danh mục</p>
          <% } %>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">📊 Thống kê</h3>
          <div class="sidebar-item">
            <span>Tổng bài viết: <strong><%= totalPosts %></strong></span>
          </div>
          <div class="sidebar-item">
            <span>Trang: <strong><%= currentPage %></strong> / <strong><%= totalPages %></strong></span>
          </div>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">💡 Mẹo</h3>
          <div class="sidebar-item">
            <small style="color: #666;">
              🔍 <strong>Ctrl + K</strong> để tìm kiếm<br>
              🌙 <strong>Ctrl + D</strong> để bật chế độ tối
            </small>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <footer>
    <span>The Blog &copy; <%= new Date().getFullYear() %></span>
    <span>Node.js + MongoDB + EJS</span>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
