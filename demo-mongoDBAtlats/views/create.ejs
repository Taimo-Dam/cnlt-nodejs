<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tạo bài viết — The Blog</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <header>
    <div class="header-top">
      <a href="/" class="logo">The Blog</a>
      <nav>
        <a href="/" class="back-link">← Về trang chủ</a>
      </nav>
    </div>
  </header>

  <main class="wrapper">
    <div class="main-content">
      <div class="content">
        <div class="container" style="max-width: 680px;">
          <div class="page-header">
            <span class="page-label">Soạn thảo</span>
            <h1 class="page-title">Tạo bài viết mới</h1>
          </div>

          <div class="form-wrap">
            <form action="/blogposts/store" method="POST">
              <div class="form-group">
                <label for="title">Tiêu đề *</label>
                <input type="text" id="title" name="title" placeholder="Nhập tiêu đề bài viết..." required>
              </div>

              <div class="form-group">
                <label for="category">Danh mục</label>
                <select id="category" name="category" style="width: 100%; padding: 10px; border: 1px solid var(--gray-mid); border-radius: var(--border-radius-sm);">
                  <option value="">-- Chọn danh mục --</option>
                  <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat._id %>"><%= cat.name %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="form-group">
                <label for="tags">Tags (cách nhau bởi dấu phẩy)</label>
                <input type="text" id="tags" name="tags" placeholder="vd: javascript, nodejs, programming">
              </div>

              <div class="form-group">
                <label for="body">Nội dung *</label>
                <textarea id="body" name="body" placeholder="Nhập nội dung bài viết..." required></textarea>
              </div>

              <div class="form-group">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                  <input type="checkbox" id="featured" name="featured">
                  <span>Đánh dấu là bài viết nổi bật</span>
                </label>
              </div>

              <div class="form-footer">
                <a href="/" class="cancel-link">Hủy</a>
                <button type="submit" class="button button-primary">Đăng bài →</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <span>The Blog &copy; <%= new Date().getFullYear() %></span>
    <span>Node.js + MongoDB + EJS</span>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
